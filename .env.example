DEEPSEEK_API_KEY=your_siliconflow_api_key
CHARACTER_NAME=蕾缪乐
# auto: local Qwen3.5 first, cloud fallback. cloud: SiliconFlow only.
TEXT_BACKEND=auto
VISION_BACKEND=auto
LOCAL_TEXT_MODEL=qwen3:8b
LOCAL_VISION_MODEL=Qwen3.5:9b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
TEXT_MODEL=Pro/deepseek-ai/DeepSeek-V3.2
CLOUD_VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
LOCAL_VISION_WARMUP=1
MEMORY_WAIT_SECONDS=0.15
LOCAL_CONTEXT_TOKENS=4096
# Applied on every native Ollama request; reduce to 5m when VRAM is needed for games.
LOCAL_KEEP_ALIVE=30m
# Do not inherit aggressive anti-repetition from a model's Modelfile.
LOCAL_PRESENCE_PENALTY=0
# Explicit sampling for non-thinking chat; avoids model-level top_p=0.95.
LOCAL_TOP_P=0.8
CHAT_TEMPERATURE=0.7
EMBEDDING_LOCAL_ONLY=1
SCREEN_MONITOR=1
ASR_ENABLED=1
PROACTIVE_ENABLED=1
# Bubble minimums; width also expands to cover the cropped avatar.
BUBBLE_MIN_WIDTH=360
BUBBLE_MIN_HEIGHT=64
# auto uses Windows Schannel curl on legacy Anaconda, HTTPX elsewhere.
CLOUD_TRANSPORT=auto
